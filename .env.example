# PostgreSQL
# If another service is already bound to host 5432 (e.g. a local Postgres),
# point docker-compose's published port at a different one without changing
# the container-internal port. The app does not read this: set DATABASE_URL
# to the same port, or the app and the database end up in different places.
# POSTGRES_HOST_PORT=5432
# Must name the psycopg2 dialect explicitly; a bare "postgresql://" is resolved
# differently depending on the installed SQLAlchemy/driver version.
# The defaults below match docker-compose.yml, so "docker compose up -d" plus
# this file work together. Change both sides together.
DATABASE_URL=postgresql+psycopg2://immigration:immigration_dev@localhost:5432/immigration
POSTGRES_DB=immigration
POSTGRES_USER=immigration
POSTGRES_PASSWORD=immigration_dev

# Registry seeding (python src/seed_registry.py)
# The CLI seeds the DATABASE_URL backend (PostgreSQL) and fails loudly when
# DATABASE_URL is missing. Set SEED_BACKEND=sqlite ONLY to force the legacy
# SQLite seed mode used by the standalone offline pipeline scripts.

# LLM Provider (OpenAI or Gemini; both are supported, and the provider is
# chosen from the model name). Extraction fails fast if the matching key is
# missing - there is NO silent fallback to a mock, because a mock would
# fabricate requirements.
OPENAI_API_KEY=sk-your-key-here
# Required only when EXTRACTION_MODEL is a gemini-* model. GOOGLE_API_KEY is
# accepted as an alias.
GEMINI_API_KEY=

# LLM requirement extraction model used by the fetch -> store -> extract path.
# Defaults to gpt-4o-mini when unset. Supported:
#   gpt-4o-mini, gpt-4o, ft:gpt-4o-mini-...      (OpenAI, needs OPENAI_API_KEY)
#   gemini-flash-lite-latest, gemini-1.5-pro     (Gemini, needs GEMINI_API_KEY)
# mock-llm-v1 is test-only; Anthropic/other providers are rejected.
EXTRACTION_MODEL=gpt-4o-mini

# Gemini quota tier, used to pick retry/backoff behaviour (free: 3 retries,
# paid: 5). Also settable per-process as GEMINI_FREE_TIER_RPM /
# GEMINI_PAID_TIER_RPM if your project quota differs from the defaults.
# GEMINI_TIER=free

# Embeddings (semantic search)
# Off by default. There is NO silent fallback to the mock client.
# If EMBEDDINGS_ENABLED=true you MUST provide a real embedding model or
# explicitly set EMBEDDING_MODEL=mock-embedding-v1 (only for offline tests).
EMBEDDINGS_ENABLED=false
# text-embedding-3-small is 1536 dimensions - it matches the pgvector column.
EMBEDDING_MODEL=text-embedding-3-small
# After enabling, backfill existing chunks (needs src/ on PYTHONPATH):
#   $env:PYTHONPATH="src"; python -m src.extraction.embeddings --backfill
# Search falls back to keyword mode until chunks are embedded, and says so.

# LLM Budget
# Low safe suggested cap for everyday use; the code falls back to 10.0 USD/day
# (200.0 USD/month) when these are left unset.
LLM_DAILY_BUDGET_USD=2.00
LLM_MONTHLY_BUDGET_USD=50.00
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# Application
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduler
ENABLE_SCHEDULER="true"
# Preferred: daily fixed-clock sync (UTC hour, minute defaults to 0).
GOVERNMENT_SYNC_HOUR_UTC="3"
# Legacy alternative: every N minutes. Used only when HOUR is unset.
# GOVERNMENT_SYNC_INTERVAL_MINUTES="60"

# Fetch backend. "playwright" (default) is the production path: one headless
# Chromium, honest user agent, bounded wait for rendered content. "legacy"
# selects the retired requests/Patchright path for a side-by-side check; it is
# slated for deletion after the human-gated live check.
FETCH_BACKEND=playwright
# Sent verbatim on every request. Do not spoof a browser or another operator.
FETCH_USER_AGENT=AU-Immigration-Source-Monitor/0.1
# 0 is for local debugging with a real display; production/CI must stay headless.
BROWSER_HEADLESS=1
# Optional: let source discovery ask the configured LLM to propose new sources.
# Off by default; any proposal still needs human review before it is fetched.
SOURCE_DISCOVERY_USE_LLM=false

# Fetch politeness & egress (source retrieval)
# Minimum spacing between two requests to the *same* host, plus additive jitter
# so the pattern is not metronomic. This is ordinary client-side etiquette, not
# evasion: it changes *when* we ask, never how we identify ourselves. Defaults:
# 8s minimum interval + up to 4s random jitter. A malformed value falls back to
# the (more polite) default rather than becoming a faster crawl.
FETCH_MIN_INTERVAL_SECONDS=8
FETCH_JITTER_SECONDS=4
# After a host answers a refusal (HTTP 403/429), pause *every* source on that
# host for this many hours before trying again. Timeouts, DNS failures and 5xx
# are faults, not refusals, and never pause anything. Set to 0 (or negative) to
# disable the pause. Default: 6.
FETCH_COOLDOWN_HOURS=6
# Optional single STATIC egress proxy for reachability/egress control, e.g.
#   http://user:pass@proxy.internal:3128   (http/https only - no SOCKS support)
# Leave blank (default) to connect directly. This is ONE fixed value — it is
# never rotated and never changes in response to a refusal. A malformed value
# FAILS CLOSED: affected fetches are refused and reported, never silently sent
# direct. Any credentials are redacted from logs and error strings.
FETCH_PROXY_URL=

# Auth
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Fetch allowlist (source URLs)
# Default: .gov.au (Australian government domains). Extend deliberately.
# Never set to '*' in production. Example: .gov.au,.abc.net.au
# Primary: FETCH_ALLOWED_DOMAINS (comma-separated). SOURCE_ALLOWED_HOST_SUFFIXES is deprecated alias.
FETCH_ALLOWED_DOMAINS=.gov.au,.abc.net.au
# SOURCE_ALLOWED_HOST_SUFFIXES=.gov.au  # deprecated alias

# Public self-registration. Default false: POST /api/v1/auth/register returns
# 403. If enabled, every self-registered account gets the applicant role only;
# admin accounts are still provisioned out of band.
ALLOW_PUBLIC_REGISTRATION=false

# Admin bootstrap (idempotent, optional)
# On startup, if BOTH ADMIN_EMAIL and ADMIN_PASSWORD are set, the app creates (or
# promotes) that admin user. When either is left blank, no admin is auto-created
# and you must use: python src/create_admin.py --email ADMIN@x --password '...'
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator