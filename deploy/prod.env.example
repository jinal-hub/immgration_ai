# Copy to a location outside version control, fill every required value, then:
#   docker compose --env-file <file> -f docker-compose.prod.yml up -d --build
#
# Never commit the filled file. The API refuses to start in production when
# required configuration is missing, weak, or still a known placeholder.

# Public DNS name that Caddy obtains a certificate for. No scheme or port.
# DOMAIN=immigration.example.gov.au

# PostgreSQL credentials. DATABASE_URL must use the container-internal host
# `postgres` and URL-encode any characters that are special in a URL password.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg2://immigration:CHANGE_ME_URLENCODED@postgres:5432/immigration

# At least 32 random characters. Generate one, do not reuse it elsewhere.
# JWT_SECRET_KEY=

# Bootstrap administrator. Used only to create/promote the first admin.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Extraction provider. Supply the key for the model you select.
EXTRACTION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Restrict sources to public government hosts. Extend deliberately, never set
# this to a bare wildcard in production.
# Primary: FETCH_ALLOWED_DOMAINS (comma-separated). SOURCE_ALLOWED_HOST_SUFFIXES is deprecated alias.
FETCH_ALLOWED_DOMAINS=.gov.au,.abc.net.au
# SOURCE_ALLOWED_HOST_SUFFIXES=.gov.au  # deprecated alias

# Optional single static egress proxy, fail-closed. Leave blank to fetch direct.
FETCH_PROXY_URL=
# Optional honest User-Agent override; the application default is used if blank.
FETCH_USER_AGENT=

ENABLE_SCHEDULER=true
GOVERNMENT_SYNC_HOUR_UTC=3
JWT_EXPIRATION_MINUTES=1440
LOG_LEVEL=INFO
